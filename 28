/* ---------- NUMEROLOGY ENGINE ---------- */

// Sum all digits of a date given as {m, d, y}. Returns raw sum before any reduction.
function rawDigitSum(m, d, y) {
  const str = String(m) + String(d) + String(y);
  return str.split('').reduce((acc, ch) => acc + Number(ch), 0);
}

// Reduce a number to a single digit, but stop early on master numbers 11, 22, 33 —
// and also on 28, the "wealth number", which per Johnny's transcripts is a fixed
// checkpoint value, not something that gets reduced further.
// Special rule: a raw sum of exactly 20 is treated as an 11-day (hidden 11).
function reduceNumerology(rawSum) {
  if (rawSum === 20) return { value: 11, path: [rawSum, 11], hidden: true };
  let n = rawSum;
  const path = [n];
  while (n > 9 && n !== 11 && n !== 22 && n !== 28 && n !== 33) {
    n = String(n).split('').reduce((a, c) => a + Number(c), 0);
    path.push(n);
  }
  return { value: n, path, hidden: false };
}

// Used for the global day-code banner + calendar: full date digit sum (month + day + full year).
function numerologyForDate(m, d, y) {
  const raw = rawDigitSum(m, d, y);
  const result = reduceNumerology(raw);
  return { number: result.value, raw, path: result.path, hidden: result.hidden };
}

// Used for entity Company/IPO/CEO "cycle" numbers: this is a PERSONAL-YEAR-STYLE calculation.
// Confirmed against the reference app's own numbers (Meta, Sep 2026):
//   CEO (May 14) in 2026:     5 + (1+4) + (2+0+2+6) = 20 -> hidden 11  == "CEO 11 CYCLE"
//   Company (Feb 4) in 2026:  2 + 4     + (2+0+2+6) = 16 -> 7          == "COMPANY 7 CYCLE"
//   IPO (May 18) in 2026:     5 + (1+8) + (2+0+2+6) = 24 -> 6          == "6" IPO number
// Note: the record's own YEAR (birth year / founding year / IPO year) is NOT used here at all —
// only its month + day, combined with the CURRENT calendar year. That's why it's a "cycle":
// it changes every year, unlike a fixed life-path number.
function cycleNumberForRecord(m, d, referenceYear) {
  const monthDigits = String(m).split('').reduce((a, c) => a + Number(c), 0);
  const dayDigits = String(d).split('').reduce((a, c) => a + Number(c), 0);
  const yearDigits = String(referenceYear).split('').reduce((a, c) => a + Number(c), 0);
  const raw = monthDigits + dayDigits + yearDigits;
  const result = reduceNumerology(raw);
  return { number: result.value, raw, path: result.path, hidden: result.hidden };
}

function dayCodeFromNumber(n) {
  if (n === 7) return 7;
  if (n === 11) return 11;
  if (n === 28) return 28; // theoretical — 28 never actually surfaces from single-date digit sums, kept for completeness
  return null;
}

// Life path number: fixed forever, calculated from the FULL birthdate (month + day + full year digits).
// Unlike the cycle number, this never changes. Keeps master numbers 11/22/33 without reducing further.
function lifePathNumber(m, d, y) {
  const raw = rawDigitSum(m, d, y);
  const result = reduceNumerology(raw);
  return { number: result.value, raw };
}

/* ---------- VIETNAMESE ZODIAC ---------- */

const ZODIAC_ORDER = ["Rat","Ox/Buffalo","Tiger","Rabbit/Cat","Dragon","Snake","Horse","Goat","Monkey","Rooster","Dog","Pig/Boar"];

// Lunar New Year actually falls in late Jan/Feb, NOT Jan 1. Anyone born before that year's
// Lunar New Year date is still counted in the PREVIOUS zodiac year. Table covers the years
// we need (birth years of tracked CEOs/founders + current years for "this year's sign").
// Source: published Vietnamese/Chinese lunar calendar new year dates.
const LUNAR_NEW_YEAR = {
  1960:"1960-01-28", 1961:"1961-02-15", 1964:"1964-02-13", 1968:"1968-01-30",
  1975:"1975-02-11", 1984:"1984-02-02", 1994:"1994-02-10", 1997:"1997-02-07",
  2004:"2004-01-22", 2011:"2011-02-03", 2012:"2012-01-23", 2020:"2020-01-25",
  2021:"2021-02-12", 2022:"2022-02-01", 2023:"2023-01-22", 2024:"2024-02-10",
  2025:"2025-01-29", 2026:"2026-02-17"
};
// Base anchor: Lunar year starting 2020-01-25 is the Year of the Rat.
function zodiacYearFor(m, d, y) {
  const lny = LUNAR_NEW_YEAR[y];
  let effectiveYear = y;
  if (lny) {
    const cutoff = new Date(lny);
    const birth = new Date(y, m - 1, d);
    if (birth < cutoff) effectiveYear = y - 1;
  }
  const idx = ((effectiveYear - 2020) % 12 + 12) % 12;
  return ZODIAC_ORDER[idx];
}

// Enemy ("No Match") pairing directly from the compatibility grid provided
const ENEMY_MAP = {
  "Rat":"Horse", "Horse":"Rat",
  "Ox/Buffalo":"Goat", "Goat":"Ox/Buffalo",
  "Tiger":"Monkey", "Monkey":"Tiger",
  "Rabbit/Cat":"Rooster", "Rooster":"Rabbit/Cat",
  "Dragon":"Dog", "Dog":"Dragon",
