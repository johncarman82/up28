<title>GAIN28 — Internal Cycle Tracker</title>
<style>
  :root{
    --bg:#0a0a0a;
    --panel:#141414;
    --panel-border:#262626;
    --red:#e5484d;
    --red-dim:#e5484d33;
    --green:#3ecf8e;
    --green-dim:#3ecf8e33;
    --gold:#d4af37;
    --text:#f2f2f0;
    --text-dim:#8a8a86;
    --text-dimmer:#5c5c58;
    --mono: 'SF Mono', 'Courier New', monospace;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:var(--sans);
    padding:20px;
    max-width:900px;
    margin:0 auto;
    line-height:1.4;
  }
  header{
    text-align:center;
    padding:24px 0 20px;
    border-bottom:1px solid var(--panel-border);
    margin-bottom:20px;
  }
  header h1{
    font-size:1.5rem;
    letter-spacing:0.02em;
    font-weight:600;
  }
  header .sub{
    color:var(--text-dim);
    font-size:0.85rem;
    margin-top:4px;
  }

  /* Day code banner */
  .day-banner{
    background:var(--panel);
    border:1px solid var(--panel-border);
    border-radius:10px;
    padding:20px 24px;
    margin-bottom:24px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    flex-wrap:wrap;
  }
  .day-banner .date-line{
    font-size:0.85rem;
    color:var(--text-dim);
  }
  .day-banner .math-line{
    font-family:var(--mono);
    font-size:0.78rem;
    color:var(--text-dimmer);
    margin-top:2px;
  }
  .day-code-badge{
    font-size:2.4rem;
    font-weight:700;
    padding:6px 22px;
    border-radius:8px;
    line-height:1;
  }
  .code-7, .code-11{ color:var(--red); background:var(--red-dim); }
  .code-28{ color:var(--green); background:var(--green-dim); }
  .code-none{ color:var(--text-dimmer); background:#1c1c1c; font-size:1.1rem; }
  .day-code-label{
    font-size:0.7rem;
    text-transform:none;
    color:var(--text-dim);
    margin-top:4px;
    text-align:center;
  }

  nav.tabs{
    display:flex;
    gap:6px;
    margin-bottom:20px;
    border-bottom:1px solid var(--panel-border);
  }
  nav.tabs button{
    background:none;
    border:none;
    color:var(--text-dim);
    font-size:0.9rem;
    padding:10px 16px;
    cursor:pointer;
    border-bottom:2px solid transparent;
  }
  nav.tabs button.active{
    color:var(--text);
    border-bottom:2px solid var(--gold);
  }

  .view{ display:none; }
  .view.active{ display:block; }

  /* Entity cards */
  .entity-card{
    background:var(--panel);
    border:1px solid var(--panel-border);
    border-radius:10px;
    padding:20px;
    margin-bottom:18px;
  }
  .tag-row{
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:8px;
    margin-bottom:16px;
  }
  .tag-row .left, .tag-row .right{
    display:flex;
    flex-direction:column;
    gap:6px;
    align-items:flex-start;
  }
  .tag-row .right{ align-items:flex-end; }
  .tag{
    font-size:0.68rem;
    font-weight:600;
    padding:5px 10px;
    border-radius:5px;
    white-space:nowrap;
  }
  .tag.short{ color:var(--red); background:var(--red-dim); }
  .tag.long{ color:var(--green); background:var(--green-dim); }
  .tag.chop{ color:#e8c547; background:#e8c54722; }
  .tag.neutral{ color:var(--gold); background:#d4af3722; }

  .bias-panel{
    border:1px solid var(--panel-border);
    border-radius:8px;
    padding:22px 16px;
    margin-bottom:16px;
    text-align:center;
  }
  .bias-word{
    font-size:1.8rem;
    font-weight:700;
    letter-spacing:0.03em;
  }
  .bias-reason{
    font-size:0.75rem;
    color:var(--text-dim);
    margin-top:4px;
  }
  .bias-score{
    font-size:0.68rem;
    color:var(--text-dimmer);
    margin-top:6px;
  }
  .bias-bearish{ background:var(--red-dim); border-color:var(--red); }
  .bias-bearish .bias-word{ color:var(--red); }
  .bias-bullish{ background:var(--green-dim); border-color:var(--green); }
  .bias-bullish .bias-word{ color:var(--green); }
  .bias-neutral{ background:#e8c54722; border-color:#e8c547; }
  .bias-neutral .bias-word{ color:#e8c547; }
  .ticker-notes{
    width:100%;
    min-height:50px;
    background:#0f0f0f;
    border:1px solid var(--panel-border);
    border-radius:6px;
    color:var(--text);
    font-size:0.8rem;
    padding:8px 10px;
    margin-bottom:16px;
    resize:vertical;
    font-family:var(--sans);
  }
  .ticker-notes:focus{ outline:none; border-color:var(--gold); }

  .entity-name{
    font-size:1.3rem;
    font-weight:700;
    margin-bottom:2px;
  }
  .entity-sub{
    color:var(--text-dim);
    font-size:0.85rem;
    margin-bottom:16px;
  }

  .datapoints{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:10px;
  }
  .datapoint{
    border:1px solid var(--panel-border);
    border-radius:8px;
    padding:12px;
  }
  .datapoint .dp-label{
    font-size:0.7rem;
    color:var(--text-dim);
    margin-bottom:6px;
  }
  .datapoint .dp-number{
    font-size:1.8rem;
    font-weight:700;
  }
  .datapoint .dp-date{
    font-size:0.68rem;
    color:var(--text-dimmer);
    margin-top:6px;
  }
  .datapoint .dp-sub{
    font-size:0.65rem;
    color:var(--text-dimmer);
    margin-top:2px;
  }

  /* Calendar */
  .cal-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:16px;
  }
  .cal-header button{
    background:var(--panel);
    border:1px solid var(--panel-border);
    color:var(--text);
    font-size:1rem;
    padding:8px 14px;
    border-radius:6px;
    cursor:pointer;
  }
  .cal-header button:hover{ border-color:var(--gold); }
  .cal-title{ font-size:1.1rem; font-weight:600; }

  .cal-grid{
    display:grid;
    grid-template-columns:repeat(7, 1fr);
    gap:4px;
    margin-bottom:28px;
  }
  .cal-dow{
