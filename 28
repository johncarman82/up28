// GG33 (Gary "The Numbers Guy" Grinberg) enemy number pairs — ONLY the two pairs publicly
// confirmed from GG33 material. 2, 5, 6, 7, 8 are intentionally left out since no reliable
// GG33 source confirms their enemy relationships — do not guess these.
const GG33_ENEMY_NUMBERS = { 1: 9, 9: 1, 3: 4, 4: 3 };
const BEST_MATCH = {
  "Rat": ["Rat","Dragon","Monkey"],
  "Ox/Buffalo": ["Ox/Buffalo","Snake","Rooster"],
  "Tiger": ["Tiger","Dog","Horse"],
  "Rabbit/Cat": ["Rabbit/Cat","Pig/Boar","Goat"],
  "Dragon": ["Dragon","Monkey","Rat"],
  "Snake": ["Snake","Rooster","Ox/Buffalo"],
  "Horse": ["Horse","Dog","Tiger"],
  "Goat": ["Goat","Pig/Boar","Rabbit/Cat"],
  "Monkey": ["Monkey","Dragon","Rat"],
  "Rooster": ["Rooster","Snake","Ox/Buffalo"],
  "Dog": ["Dog","Tiger","Horse"],
  "Pig/Boar": ["Pig/Boar","Rabbit/Cat","Goat"]
};

function currentZodiacSign() {
  const now = new Date();
  return zodiacYearFor(now.getMonth() + 1, now.getDate(), now.getFullYear());
}

function isEnemyYear(birthM, birthD, birthY) {
  const personSign = zodiacYearFor(birthM, birthD, birthY);
  const thisYearSign = currentZodiacSign();
  return ENEMY_MAP[personSign] === thisYearSign ? thisYearSign : null;
}

// The "universal year number" — just the current year's digits, reduced (master numbers kept).
function universalYearNumber() {
  const y = new Date().getFullYear();
  const raw = String(y).split('').reduce((a, c) => a + Number(c), 0);
  return reduceNumerology(raw).value;
}

// Combined bias: cycle numbers + zodiac relationship + GG33 life-path-vs-universal-year enemy check.
// Whichever side (bullish/bearish) has more points wins; a tie is neutral.
function calcBias(companyCycle, ceoCycle, ceoM, ceoD, ceoY) {
  const ceoSign = zodiacYearFor(ceoM, ceoD, ceoY);
  const thisYearSign = currentZodiacSign();
  const ceoLifePath = lifePathNumber(ceoM, ceoD, ceoY).number;
  const yearNum = universalYearNumber();

  let bullPoints = 0, bearPoints = 0;
  const bullReasons = [], bearReasons = [];

  if (companyCycle === 28 || ceoCycle === 28) {
    bullPoints++; bullReasons.push('cycle hit 28 (wealth number)');
  }
  if (ceoSign === thisYearSign) {
    bullPoints++; bullReasons.push(`CEO's own sign (${ceoSign}) matches this year`);
  }
  if (BEST_MATCH[ceoSign] && BEST_MATCH[ceoSign].includes(thisYearSign) && ceoSign !== thisYearSign) {
    bullPoints++; bullReasons.push(`${ceoSign} is a Best Match with this year's ${thisYearSign}`);
  }

  if (companyCycle === 7 || companyCycle === 11 || ceoCycle === 7 || ceoCycle === 11) {
    bearPoints++; bearReasons.push('cycle hit 7 or 11');
  }
  if (ENEMY_MAP[ceoSign] === thisYearSign) {
    bearPoints++; bearReasons.push(`${ceoSign} is the enemy sign of this year's ${thisYearSign}`);
  }
  if (GG33_ENEMY_NUMBERS[ceoLifePath] === yearNum) {
    bearPoints++; bearReasons.push(`CEO life path ${ceoLifePath} is a GG33 enemy number of this year's ${yearNum}`);
  }

  let verdict = 'neutral', reasons = ['No cycle or zodiac edge either way'];
  if (bullPoints > bearPoints) { verdict = 'bullish'; reasons = bullReasons; }
  else if (bearPoints > bullPoints) { verdict = 'bearish'; reasons = bearReasons; }

  return { verdict, reasons, bullPoints, bearPoints };
}

