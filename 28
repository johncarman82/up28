];

/* ---------- RENDER: DAY BANNER ---------- */

function renderDayBanner() {
  const now = new Date();
  const m = now.getMonth() + 1, d = now.getDate(), y = now.getFullYear();
  const result = numerologyForDate(m, d, y);
  const code = dayCodeFromNumber(result.number);

  const dateStr = now.toLocaleDateString('en-US', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
  const mathStr = `${m} + ${d} + ${String(y).split('').join(' + ')} = ${result.raw}` +
                  (result.hidden ? ` → treated as hidden 11` : (result.path.length > 1 ? ` → ${result.path.slice(1).join(' → ')}` : ``));

  let badgeClass = 'code-none', badgeText = '—', label = 'No defined bias today';
  if (code === 7) { badgeClass = 'code-7'; badgeText = '7'; label = 'Short bias day'; }
  else if (code === 11) { badgeClass = 'code-11'; badgeText = '11'; label = 'Short bias day (emotional)'; }
  else if (code === 28) { badgeClass = 'code-28'; badgeText = '28'; label = 'Long bias day'; }

  document.getElementById('dayBanner').innerHTML = `
    <div>
      <div class="date-line">${dateStr}</div>
      <div class="math-line">${mathStr}</div>
    </div>
    <div style="text-align:center;">
      <div class="day-code-badge ${badgeClass}">${badgeText}</div>
      <div class="day-code-label">${label}</div>
    </div>
  `;
}

/* ---------- RENDER: ENTITY PROFILES ---------- */

function renderEntities(filterQuery) {
  const container = document.getElementById('entitiesView');
  container.innerHTML = '';

  const q = (filterQuery || '').trim().toLowerCase();

  if (!q) {
    container.innerHTML = `<div class="note" style="text-align:center;">Type a ticker symbol or company/CEO name above to pull up a profile.</div>`;
    return;
  }

  const filtered = ENTITIES.filter(e => {
    return e.name.toLowerCase().includes(q) ||
           e.company.toLowerCase().includes(q) ||
           e.ticker.toLowerCase().includes(q);
  });

  if (filtered.length === 0) {
    container.innerHTML = `<div class="note">No matching company, ticker, or CEO found.</div>`;
    return;
  }

  const currentYear = new Date().getFullYear();

  filtered.forEach(e => {
    // Both the top tags AND the bottom boxes use the same dynamic CYCLE number
    // (month+day of the record + current calendar year, reduced). Confirmed exact
    // match to the reference app using Zuckerberg's card: Company 7, IPO 6, CEO 11.
    const companyCycle = cycleNumberForRecord(e.companyDOB.m, e.companyDOB.d, currentYear).number;
    const ipoCycle = cycleNumberForRecord(e.ipoDOB.m, e.ipoDOB.d, currentYear).number;
    const ceoCycle = cycleNumberForRecord(e.ceoDOB.m, e.ceoDOB.d, currentYear).number;

    const enemyYear = isEnemyYear(e.ceoDOB.m, e.ceoDOB.d, e.ceoDOB.y);
    const bias = calcBias(companyCycle, ceoCycle, e.ceoDOB.m, e.ceoDOB.d, e.ceoDOB.y);

    const tagsLeft = [];
    if (bias.verdict === 'bearish') tagsLeft.push(`<span class="tag short">SHORT-FAVORED (YEARLY)</span>`);
    if (bias.verdict === 'bullish') tagsLeft.push(`<span class="tag long">LONG-FAVORED (YEARLY)</span>`);
    if (bias.verdict === 'neutral') tagsLeft.push(`<span class="tag chop">NEUTRAL (YEARLY)</span>`);

    const tagsRight = [];
    tagsRight.push(`<span class="tag neutral">COMPANY ${companyCycle} CYCLE</span>`);
    tagsRight.push(`<span class="tag neutral">CEO ${ceoCycle} CYCLE</span>`);
    if (enemyYear) tagsRight.push(`<span class="tag short">CEO ${enemyYear.toUpperCase()} ENEMY YEAR</span>`);

    const fmt = (dp) => new Date(dp.y, dp.m - 1, dp.d).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' });

    container.innerHTML += `
      <div class="entity-card">
        <div class="tag-row">
          <div class="left">${tagsLeft.join('')}</div>
          <div class="right">${tagsRight.join('')}</div>
        </div>
        <div class="bias-panel bias-${bias.verdict}">
          <div class="bias-word">${bias.verdict === 'bullish' ? 'LONG-FAVORED' : bias.verdict === 'bearish' ? 'SHORT-FAVORED' : 'NEUTRAL'}</div>
        </div>
        <textarea class="ticker-notes" data-ticker="${e.ticker}" placeholder="Notes on ${e.ticker}... (saved in this browser only)"></textarea>
        <div class="entity-name">${e.name}</div>
        <div class="entity-sub">${e.company} · ${e.ticker}</div>
        <div class="datapoints">
          <div class="datapoint">
            <div class="dp-label">Company</div>
            <div class="dp-number">${companyCycle}</div>
            <div class="dp-date">Company DOB</div>
            <div class="dp-sub">${fmt(e.companyDOB)}</div>
          </div>
          <div class="datapoint">
            <div class="dp-label">IPO</div>
            <div class="dp-number">${ipoCycle}</div>
            <div class="dp-date">IPO DOB</div>
            <div class="dp-sub">${fmt(e.ipoDOB)}</div>
          </div>
          <div class="datapoint">
            <div class="dp-label">CEO</div>
            <div class="dp-number">${ceoCycle}</div>
            <div class="dp-date">CEO DOB</div>
            <div class="dp-sub">${fmt(e.ceoDOB)}</div>
          </div>
        </div>
      </div>
    `;
  });

  // Load saved notes and wire up auto-save
  document.querySelectorAll('.ticker-notes').forEach(ta => {
    const key = 'gain28_notes_' + ta.dataset.ticker;
    ta.value = localStorage.getItem(key) || '';
    ta.addEventListener('input', () => localStorage.setItem(key, ta.value));
  });
}

/* ---------- RENDER: CALENDAR ---------- */

let calMonthOffset = 0; // 0 = current month, up to 11 (full 12-month lookahead)

function renderCalendar() {
  const container = document.getElementById('calendarView');
  const base = new Date();
  const viewDate = new Date(base.getFullYear(), base.getMonth() + calMonthOffset, 1);
  const year = viewDate.getFullYear(), month = viewDate.getMonth();

  const firstDow = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();
  const monthLabel = viewDate.toLocaleDateString('en-US', { month:'long', year:'numeric' });

  const todayStr = new Date().toDateString();

  let cells = '';
  for (let i = 0; i < firstDow; i++) cells += `<div class="cal-cell empty"></div>`;
  for (let day = 1; day <= daysInMonth; day++) {
    const result = numerologyForDate(month + 1, day, year);
    const code = dayCodeFromNumber(result.number);
    const cellDate = new Date(year, month, day);
    const isToday = cellDate.toDateString() === todayStr;
    let codeClass = '';
    let codeLabel = '';
    if (code === 7) { codeClass = 'code-7'; codeLabel = '7'; }
    else if (code === 11) { codeClass = 'code-11'; codeLabel = '11'; }
    else if (code === 28) { codeClass = 'code-28'; codeLabel = '28'; }

    cells += `
      <div class="cal-cell ${codeClass} ${isToday ? 'today' : ''}">
        <div class="cal-daynum">${day}</div>
        <div class="cal-code">${codeLabel}</div>
      </div>
    `;
  }

  const dows = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d => `<div class="cal-dow">${d}</div>`).join('');

  container.innerHTML = `
    <div class="cal-header">
      <button id="calPrev">← Prev</button>
      <div class="cal-title">${monthLabel}</div>
      <button id="calNext">Next →</button>
    </div>
    <div class="legend">
      <span><i style="background:var(--red)"></i> 7 / 11 day (short bias)</span>
      <span><i style="background:var(--green)"></i> 28 day (long bias)</span>
    </div>
    <div class="cal-grid">
      ${dows}
      ${cells}
    </div>
  `;

  document.getElementById('calPrev').onclick = () => {
    if (calMonthOffset > 0) { calMonthOffset--; renderCalendar(); }
  };
  document.getElementById('calNext').onclick = () => {
    if (calMonthOffset < 11) { calMonthOffset++; renderCalendar(); }
  };
}

/* ---------- TABS ---------- */

document.querySelectorAll('.tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(btn.dataset.view + 'View').classList.add('active');
  });
});

/* ---------- INIT ---------- */

renderDayBanner();
renderEntities();
renderCalendar();

document.getElementById('searchInput').addEventListener('input', (e) => {
  renderEntities(e.target.value);
});

// Keep the day banner live without needing a refresh
setInterval(renderDayBanner, 60 * 1000);
</script>

